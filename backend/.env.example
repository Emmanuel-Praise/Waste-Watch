# Waste Watch — backend environment template
# Copy to `.env` and fill in your values. Never commit real secrets.
#
# REQUIRED on Render (set in the dashboard — baked from render.yaml):
#   WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_ID, WHATSAPP_VERIFY_TOKEN,
#   OPENROUTER_API_KEY, ELEVENLABS_API_KEY
# OPTIONAL on Render (leave empty if unused):
#   FRONTEND_URL, WHATSAPP_APP_SECRET, NVIDIA_API_KEY, COMMUNITY_HEAD_PHONE
# Everything else below already has a working default in config.py —
# only set it if you want to override it.

# ---- WhatsApp / Meta Cloud API (required) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=bamendaWebhookV1
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# Message delivery: "log" (simulator only) or "whatsapp" (real delivery)
MESSAGE_CHANNEL=log

# ---- AI providers ----
VISION_PROVIDER=openrouter
OPENROUTER_API_KEY=
VISION_MODEL=nex-agi/nex-n2.5-pro:free
TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEXT_MODEL=meta/llama-3.2-11b-vision-instruct

# ---- Meterless local model proxy (optional, best-effort) ----
# Local OpenAI-compatible proxy (Nightshift runtime). First choice for the
# citizen text replies in services/llm.py; when it is off, the token is
# missing or the proxy is down, replies fall back to OpenRouter/NVIDIA.
# The bearer token is read from METERLESS_TOKEN_PATH on EVERY call, so a
# rotated token needs no restart. Empty path =
#   %LOCALAPPDATA%\ai.meterless.runtime\proxy-token   (Windows)
METERLESS_ENABLED=true
METERLESS_BASE_URL=http://127.0.0.1:8088
METERLESS_MODEL=worker
METERLESS_TOKEN_PATH=
METERLESS_TIMEOUT_SECONDS=60

# Speech-to-text: "mock" | "groq" | "elevenlabs"
SPEECH_PROVIDER=elevenlabs
GROQ_API_KEY=
SPEECH_MODEL=whisper-large-v3

# ElevenLabs (voice notes + voice report transcription via Scribe)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_PREFER_ELEVENLABS=true

# ---- Waste marketplace (business layer) ----
# Phone (E.164, e.g. +2376XXXXXXXX) of the community head who receives
# hazardous / medical escalations. Leave empty to log only.
COMMUNITY_HEAD_PHONE=

# Money split of every vendor deal (percentages of deal value)
REPORTER_COMMISSION_PCT=10
COLLECTOR_PAYOUT_PCT=55

# ---- Intake tuning (defaults are fine) ----
VERIFICATION_THRESHOLD=0.45
VERIFICATION_MAX_ATTEMPTS=1
PENDING_EXPIRY_MINUTES=60
BRAND_IMAGE_PATH=../wastewatch.png
TICKET_PREFIX=WST

# ---- Staff login (dashboard: admin + council) ----
# Default accounts are created on first start. Set these to override.
ADMIN_EMAIL=admin@bamenda.cm
ADMIN_PASSWORD=admin123
COUNCIL_EMAIL=council@bamenda.cm
COUNCIL_PASSWORD=council123

# ---- Database ----
# Local development defaults to SQLite (backend/bamenda.db) when this is
# unset. Zetaris can only read live app data when the app runs on MySQL, so
# local setups point at XAMPP/MariaDB:
# DATABASE_URL=mysql+pymysql://wastewatch_app:<password>@127.0.0.1:3306/wastewatch?charset=utf8mb4
# On Render keep the SQLite disk URL instead (render.yaml sets it).

# ---- Zetaris analytics gateway (optional, best-effort) ----
# Powers GET /api/insights. Leave ZETARIS_EMAIL/PASSWORD empty to disable it:
# the API then answers 503 and the dashboard shows "not connected".
ZETARIS_BASE_URL=http://127.0.0.1:3000
ZETARIS_EMAIL=admin@zetaris.com
ZETARIS_PASSWORD=
# Catalog name registered in Zetaris for this app's MySQL schema
ZETARIS_DATABASE=WASTE_WATCH
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_CORROBORATION_DAYS=7

# ---- Hosting (Render dashboard only — NOT local .env) ----
# DATABASE_URL=sqlite:////opt/render/project/src/backend/data/bamenda.db
# MEDIA_DIR=/opt/render/project/src/backend/data/media
# FRONTEND_URL=https://wastewatch-frontend.onrender.com
# PYTHON_VERSION=3.11.9
